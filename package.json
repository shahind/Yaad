{
  "name": "yaad",
  "version": "1.0.0",
  "private": true,
  "description": "Yaad (یاد) — fast, lightweight, fully offline Dehkhoda dictionary for web, Android, iOS, Windows and Linux",
  "author": {
    "name": "Shahin",
    "email": "shahin.shdm@gmail.com"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://shahind.github.io/Yaad/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shahind/Yaad.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:data": "node --max-old-space-size=8192 tools/build-data.mjs",
    "test": "node tools/test-search.mjs",
    "serve": "node tools/serve.mjs",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js','www/js/vendor/capacitor.js')\"",
    "electron": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "cap:sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor #ffffff --iconBackgroundColorDark #ffffff --splashBackgroundColor #ffffff --splashBackgroundColorDark #0f1724"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vazirmatn": "^33.0.3"
  },
  "build": {
    "appId": "io.github.shahind.yaad",
    "productName": "Yaad",
    "copyright": "Yaad — Dehkhoda dictionary",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon-only.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Yaad-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Yaad-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "resources/icon-only.png",
      "synopsis": "Offline Dehkhoda dictionary",
      "maintainer": "Shahin <shahin.shdm@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.reference",
      "icon": "resources/icon-only.png"
    }
  }
}
